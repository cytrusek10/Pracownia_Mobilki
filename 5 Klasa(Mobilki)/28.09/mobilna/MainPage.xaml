<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobilna.MainPage">
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Entry x:Name="NoteEntry" Placeholder="Nowy element" WidthRequest="270" />
            <Button Text="DODAJ" BackgroundColor="#DC143C" TextColor="White" Clicked="OnAddClicked" />
        </HorizontalStackLayout>
        <ListView x:Name="NotesListView" SeparatorColor="Crimson" SeparatorVisibility="Default" HeightRequest="500" />
    </VerticalStackLayout>
</ContentPage>
