<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobile.MainPage">

    <VerticalStackLayout Padding="0,20,0,0">

        <Label Text="Domek w górach" FontSize="32" />

        <Image Source="obraz.jpg" Aspect="AspectFill" HorizontalOptions="Fill" HeightRequest="150" />

        <HorizontalStackLayout BackgroundColor="#008080" HorizontalOptions="Fill" Spacing="0">
            <Button Text="POLUB" Clicked="OnLikeClicked"
                    BackgroundColor="#008080" TextColor="White" WidthRequest="120" />
            <Button Text="USUŃ" Clicked="OnRemoveClicked"
                    BackgroundColor="#008080" TextColor="White" WidthRequest="120" />
            <Button Text="ZAPISZ"
                    BackgroundColor="#008080" TextColor="White" WidthRequest="120" />
        </HorizontalStackLayout>

        <Label x:Name="LikesLabel" Text="0 polubień" HorizontalOptions="Fill"
               HorizontalTextAlignment="End" Margin="0,5,10,5" />

        <BoxView HeightRequest="1" Color="#808080" HorizontalOptions="Fill" />

        <Label Text="Opis" FontAttributes="Bold" Margin="5,5,5,0" />
        <Label Text="Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych"
               TextColor="#808080" FontSize="14" Margin="5" />
    </VerticalStackLayout>
</ContentPage>
