<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobilna.MainPage"
             BackgroundColor="#ADD8E6">
    <VerticalStackLayout BackgroundColor="#ADD8E6">
        <Label Text="Urządzenia Domowe" FontSize="Large" HorizontalOptions="Center" Margin="5" />
        <Label Text="Autor: 00000000000" HorizontalOptions="Center" Margin="5" />

        <HorizontalStackLayout>
            <Image Source="pralka.jpg" HeightRequest="150" Margin="20,0,20,20" />
            <VerticalStackLayout>
                <Label Text="Pralka" FontSize="Large" />
                <Entry x:Name="WashEntry" Placeholder="Podaj nr prania 1..12" Keyboard="Numeric"
                       BackgroundColor="#87CEEB" TextColor="#000080" PlaceholderColor="#000080" />
                <Button Text="Zatwierdź" BackgroundColor="#4169E1" TextColor="White" Margin="10"
                        Clicked="OnConfirmClicked" />
                <Label x:Name="WashLabel" Text="Numer prania: nie podano" />
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Image Source="odkurzacz.jpg" HeightRequest="150" Margin="20,0,20,20" />
            <VerticalStackLayout>
                <Label Text="Odkurzacz" FontSize="Large" />
                <Button x:Name="VacuumButton" Text="Włącz" BackgroundColor="#4169E1" TextColor="White"
                        Margin="10" Clicked="OnVacuumClicked" />
                <Label x:Name="VacuumLabel" Text="Odkurzacz wyłączony" />
                <Label Text="Status: naładowany" />
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
