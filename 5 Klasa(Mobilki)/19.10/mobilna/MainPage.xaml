<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobile.MainPage"
             Title="Dodaj pracownika - 00000000000"
             BackgroundColor="#B0C4DE">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <Border Stroke="White" StrokeThickness="2" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Dane pracownika" TextColor="Black" FontAttributes="Bold" />
                    <Label Text="Imię" TextColor="Black" />
                    <Entry x:Name="FirstNameEntry" BackgroundColor="White" TextColor="Black" />
                    <Label Text="Nazwisko" TextColor="Black" />
                    <Entry x:Name="LastNameEntry" BackgroundColor="White" TextColor="Black" />
                    <Label Text="Stanowisko" TextColor="Black" />
                    <Picker x:Name="PositionPicker" BackgroundColor="White" TextColor="Black" Title="Wybierz stanowisko" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="White" StrokeThickness="2" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Generowanie hasła" TextColor="Black" FontAttributes="Bold" />
                    <Label Text="Ile znaków?" TextColor="Black" />
                    <Entry x:Name="PasswordLengthEntry" Keyboard="Numeric" BackgroundColor="White" TextColor="Black" />

                    <HorizontalStackLayout>
                        <CheckBox x:Name="LettersCheckBox" IsChecked="True" />
                        <Label Text="Małe i wielkie litery" TextColor="Black" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <CheckBox x:Name="DigitsCheckBox" />
                        <Label Text="Cyfry" TextColor="Black" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <CheckBox x:Name="SpecialCheckBox" />
                        <Label Text="Znaki specjalne" TextColor="Black" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Button Text="Generuj hasło" Clicked="OnGeneratePasswordClicked"
                            BackgroundColor="#4682B4" TextColor="White" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Zatwierdź" Clicked="OnConfirmClicked"
                    BackgroundColor="#4682B4" TextColor="White" HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
