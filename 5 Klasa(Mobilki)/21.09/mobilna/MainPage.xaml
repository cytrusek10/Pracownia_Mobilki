<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobilna.MainPage">
    <VerticalStackLayout Margin="20">
        <Label Text="Właściwości czcionki" FontSize="Large" FontAttributes="Bold"
               BackgroundColor="#558B2F" TextColor="White" HorizontalOptions="Fill" />
        <Label x:Name="SizeLabel" Text="Rozmiar: " FontSize="Medium" TextColor="Black"
               BackgroundColor="#558B2F" HorizontalOptions="Fill" />
        <Slider x:Name="SizeSlider" Minimum="0" Maximum="40" HorizontalOptions="Fill"
                BackgroundColor="#558B2F" ValueChanged="OnSliderValueChanged" />
        <Label x:Name="QuoteLabel" Text="Dzień dobry" TextColor="Black"
               BackgroundColor="#558B2F" HorizontalOptions="Fill" />
        <Button Text=">>" FontAttributes="Bold" TextColor="White" BackgroundColor="#558B2F"
                HorizontalOptions="Center" Clicked="OnNextQuoteClicked" />
    </VerticalStackLayout>
</ContentPage>
