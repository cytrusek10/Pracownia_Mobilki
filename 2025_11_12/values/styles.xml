<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BasePadding">
        <item name="android:padding">10dp</item>
    </style>

    <style name="BaseText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:typeface">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MyStyle" parent="BasePadding">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="NotMyStyle" parent="BaseText">
        <item name="android:textColor">#305530</item>
        <item name="android:background">#c6ecc6</item>
    </style>

    <style name="MyStyle.Extended" parent="MyStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">#e0bbe4</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="NotMyStyle.Red" parent="BaseText">
        <item name="android:textColor">#553030</item>
        <item name="android:background">#ecc6c6</item>
    </style>

</resources>
